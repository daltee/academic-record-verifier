{
  "info": {
    "_postman_id": "d1607686-1f24-4b13-b96e-ec5294d53d71",
    "name": "Academic Record Verifier - Invalid Requests",
    "description": "Negative tests for POST /api/verify. The endpoint and request fields follow the frontend verification form; status codes are the proposed API contract documented in docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Missing registration number",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verificationCode\": \"invalid-test-code\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "A registration number is required. Expected response: 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 for a missing registration number', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing verification code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"INVALID-TEST-STUDENT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "A verification code is required. Expected response: 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 for a missing verification code', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Blank verification fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"   \",\n  \"verificationCode\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "Whitespace-only values are invalid. Expected response: 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 for blank verification fields', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Wrong field types",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": 12345,\n  \"verificationCode\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "Both fields must be strings. Expected response: 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 when fields have the wrong type', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"registrationNumber\": ",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "The body is intentionally invalid JSON. Expected response: 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 for malformed JSON', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unmatched registration number and code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"2099/BSE/999\",\n  \"verificationCode\": \"INVALID-TEST-CODE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "verify"
          ]
        },
        "description": "Well-formed but unmatched test values must not verify a record. Expected response: 404 Not Found, without transcript details."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404 for an unmatched record', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
