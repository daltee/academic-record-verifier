# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Use MongoDB Atlas connection string (recommended) or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/transcript-verifier?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_strong_secret_key_here_change_this
JWT_EXPIRES_IN=1d

# Optional – for signature / anti-forgery
SIGNATURE_SECRET=another_strong_secret_for_hashing_transcripts